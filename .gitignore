# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*~
.idea/
.vscode/

# Logs & temp
*.log
tmp/
*.tmp

# dl CLI persisted state (#128) — runtime, never committed
.dl-state.json
*.dl-state.json

# Transient compound-loop gate state (runtime, not source)
.claude/.needs-compound
.claude/.compound-done

# Local agent session memory (also self-ignored via .remember/.gitignore)
.remember/

# Secrets / environment (never commit; see Article XXVI)
.env
.env.*
!.env.example

# Forward-looking build/runtime artifacts
node_modules/
dist/
build/
coverage/
.cache/
__pycache__/
*.pyc

# Rust / Cargo build output (commit Cargo.lock, ignore target/)
/target/
**/target/
# Swift / SwiftPM build output
.build/
*.xcodeproj/xcuserdata/

# Xcode / SwiftPM per-user IDE state
**/xcuserdata/
*.xcuserstate
ios/.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# UniFFI build outputs (H1 / T037) — generated by `make xcframework`, never committed.
# The README.md in ios/Generated/ IS committed (it documents consumption); the artifacts
# are not.
ios/Generated/*.xcframework/
ios/Generated/*.swift
ios/Generated/kotlin/
!ios/Generated/README.md
